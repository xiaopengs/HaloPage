# 服务配置示例：复制为 .env 并修改
PORT=3000

# 必须修改：JWT 签名密钥与运营后台令牌
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-admin-token

# Token 有效期
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL_DAYS=7

# 数据与存储（默认即可）
DB_FILE=./data/homework.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# AI 识别（可选）：主链路 Qwen-VL（阿里云百炼）
# LLM_PRIMARY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_PRIMARY_API_KEY=
# LLM_PRIMARY_MODEL=qwen-vl-max

# AI 识别（可选）：备用链路 任意 OpenAI 兼容多模态端点
# LLM_BACKUP_BASE_URL=https://api.openai.com/v1
# LLM_BACKUP_API_KEY=
# LLM_BACKUP_MODEL=gpt-4o

# 识别超时（毫秒）
LLM_TIMEOUT_MS=25000
